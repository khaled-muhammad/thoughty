        </p>
        
        <div class="bg-slate-700 p-4 rounded-xl w-full mb-6">
          <p class="text-green-300 font-mono">
            <span class="text-pink-400">const</span> <span class="text-blue-400">secretKey</span> = <span class="text-amber-300">"KVM"</span>;
          </p>
        </div>
        
