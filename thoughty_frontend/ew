function closeModal() {
  modalOpen = false
  const modal = document.getElementById('modal')
  
  modal.querySelector('.relative').classList.remove('scale-100', 'translate-y-0')
  modal.querySelector('.relative').classList.add('scale-95', 'translate-y-8')
  modal.querySelector('.bg-black\\/50').classList.remove('opacity-100')
  modal.querySelector('.bg-black\\/50').classList.add('opacity-0')
  
  setTimeout(() => {
    modal.classList.remove('opacity-100')
    modal.classList.add('opacity-0', 'pointer-events-none')
    document.body.style.overflow = ''
  }, 300)
}

function updateHexDisplay() {
  const display = document.querySelector('#code2-display')
  const deleteBtn = document.querySelector('#delete-btn')
  
  display.textContent = hexCode
  deleteBtn.classList.toggle('hidden', hexCode == '')
  
  if (hexCode == '4B 56 4D') {
    setTimeout(() => {
      animating = true
      thirdPuzzleOpen = true
      
      const waveEl = document.querySelector('#wave-container')
      waveEl.classList.remove('opacity-0')
      waveEl.classList.add('opacity-100')
      
      const puzzle3 = document.querySelector('#puzzle-3')
      puzzle3.classList.remove('hidden')
      puzzle3.classList.add('flex')
      
      setTimeout(() => {
        puzzle3.scrollIntoView({ behavior: 'smooth' })
      }, 500)
      
      setTimeout(() => {
        animating = false
        waveEl.classList.remove('opacity-100')
        waveEl.classList.add('opacity-0')
      }, 1500)
    }, 1000)
  }
}

function updateProgressBar() {
  const bar = document.querySelector('#fillup')
  
  if (hexCode == '4B 56 4D') {
    bar.classList.remove('h-0');
    bar.classList.remove('h-35');
    bar.classList.remove('h-70');

    bar.classList.add('h-100');
  } else if (hexCode.startsWith('4B 56')) {
    bar.classList.remove('h-0');
    bar.classList.remove('h-35');
    bar.classList.remove('h-100');

    bar.classList.add('h-70');
  } else if (hexCode.startsWith('4B')) {
    bar.classList.remove('h-0');
    bar.classList.remove('h-70');
    bar.classList.remove('h-100');

    bar.classList.add('h-35');
  } else {
    bar.classList.remove('h-35');
    bar.classList.remove('h-70');
    bar.classList.remove('h-100');  
    bar.classList.add('h-0');
  }
}

function onStarClick(starId) {
  if (gameComplete) {
    return;
  }

  const alreadySelected = selectedStars.indexOf(starId);

  if (alreadySelected != -1) {
    selectedStars.splice(alreadySelected, 1);
  } else {
    selectedStars.push(starId);

    if (selectedStars.length == rightOrder.length) {
      let allMatch = true;
      for (let i = 0; i < rightOrder.length; i++) {
        if (selectedStars[i] != rightOrder[i]) {
          allMatch = false;
          break;
        }
      }

      if (allMatch) {
        gameComplete = true;
        setTimeout(openModal, 500);
      } else {
        setTimeout(function () {
          selectedStars.length = 0;
          updateStarDisplay();
        }, 1000);
      }
    }
  }

  updateStarDisplay();
}

function updateStarDisplay() {
  const counter = document.querySelector('#star-progress')
  const svg = document.querySelector('#star-lines')
  const btns = document.querySelectorAll('.star-btn')
  
  counter.textContent = `${selectedStars.length}/${rightOrder.length}`
  
  svg.innerHTML = ''
  
  selectedStars.forEach((starId, id) => {
    if (id == 0) {
      return;
    }
    
    const curr = starPositions.find(s => s.id == starId)
    const prev = starPositions.find(s => s.id == selectedStars[id - 1])
    
    const l = document.createElementNS('http://www.w3.org/2000/svg', 'line')
    l.setAttribute('x1', `${prev.x}%`)
    l.setAttribute('y1', `${prev.y}%`)
    l.setAttribute('x2', `${curr.x}%`)
    l.setAttribute('y2', `${curr.y}%`)
    l.setAttribute('stroke', 'cyan')
    l.setAttribute('stroke-width', '2')

    if (gameComplete) {
      l.classList.add('animate-pulse')
    }
    
    svg.appendChild(l)
  })
  
  btns.forEach(stBtn => {
    const starId   = parseInt(stBtn.dataset.starId)
    const starInfo = starPositions.find(s => s.id == starId)
    const active   = selectedStars.includes(starId)
    
    stBtn.className = `star-btn absolute transform -translate-x-1/2 -translate-y-1/2 rounded-full transition-all duration-300 hover:scale-125 ${
      active
        ? 'bg-cyan-400 shadow-cyan-400/50 shadow-lg'
        : 'bg-yellow-200 hover:bg-yellow-300'
    } ${gameComplete ? 'animate-pulse' : ''}`
    
    const size = starInfo.size + (active ? 4 : 0);
    stBtn.style.width = `${size}px`
    stBtn.style.height = `${size}px`
    
    const old = stBtn.querySelector('span');
    if (old) {
      old.remove()
    }
    
    if (active) {
      const label = '<span class="absolute -top-8 left-1/2 transform -translate-x-1/2 text-cyan-400 text-sm font-bold">' + (selectedStars.indexOf(starId) + 1) + '</span>'
      stBtn.innerHTML += label
    }
  })
}

function clearStars() {
  selectedStars = []
  gameComplete = false
  updateStarDisplay()
}

function checkDeviceType() {
  let userAgent = navigator.userAgent.toLowerCase()
  mobile = /android|phone|tablet|mobile/i.test(userAgent)
}

function setupEvents() {
  const secretInput = document.querySelector('#secret-input')
  const openBtn = document.querySelector('#open-secret')
  const closeBtn = document.querySelector('#close-modal')
  const numberButtons = document.querySelectorAll('.btn')
  const deleteBtn = document.querySelector('#delete-btn')
  const starButtons = document.querySelectorAll('.star-btn')
  const resetBtn = document.querySelector('#reset-stars')
  const modal = document.querySelector('#modal')

  secretInput.addEventListener('input', onSecretInput)
  openBtn.addEventListener('click', openModal)
  closeBtn.addEventListener('click', closeModal)
  deleteBtn.addEventListener('click', () => {
    hexCode = hexCode.slice(0, -1)
    updateHexDisplay()
  })
  resetBtn.addEventListener('click', clearStars)

  numberButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const digit = e.target.dataset.value
      hexCode = (hexCode + digit).replace(/\s+/g, '').match(/.{1,2}/g)?.join(' ') || ''
      updateHexDisplay()
      updateProgressBar()
    })
  })

  starButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const starId = parseInt(e.target.dataset.starId)
      onStarClick(starId)
    })
  })

  modal.addEventListener('click', (e) => {
    if (e.target == modal) {
      closeModal();
    }
  })

  document.addEventListener('keydown', (e) => {
    if (e.key == 'Escape' && modalOpen) {
      closeModal();
    }
  })

  window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX
    mouseY = e.clientY
    updateElementPositions()
  })

  window.addEventListener('touchmove', (e) => {
    if (!e.touches?.[0]) return
    mouseX = e.touches[0].clientX
    mouseY = e.touches[0].clientY
    updateElementPositions()
    e.preventDefault()
  }, { passive: false })

  window.addEventListener('deviceorientation', (e) => {
    if (!mobile || !e.gamma || !e.beta) return
    
    let maxTilt = 15
    let leftRight = Math.min(Math.max(e.gamma, -maxTilt), maxTilt) / maxTilt
    let upDown = Math.min(Math.max(e.beta - 40, -maxTilt), maxTilt) / maxTilt
    
    mouseX = (leftRight + 1) / 2 * window.innerWidth
    mouseY = (upDown + 1) / 2 * window.innerHeight
    updateElementPositions()
  })

  window.addEventListener('resize', () => {
    clearTimeout(window.resizeTimer)
    window.resizeTimer = setTimeout(() => {
      checkDeviceType()
    }, 300)
  })
}

makeBackgroundStars()
setupEvents()
updateElementPositions()