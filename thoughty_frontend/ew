  document.body.style.overflow = 'hidden'
  
  if (gameComplete) {
    titleEl.textContent = 'MysUiz Finished'
    contentEl.innerHTML = `
      <div class="flex flex-col items-center">
        <div class="w-24 h-24 mb-6 rounded-full flex items-center justify-center bg-gradient-to-b from-slate-500 to-slate-600 shadow-lg drop-shadow-2xl">
          <i class="fas fa-star fa-2x" style="color: white;"></i>
        </div>
        
        <h3 class="text-2xl bangers-regular text-center mb-4">Congrats!</h3>
        
        <p class="text-center mb-6 text-lg">
          You have finally reached the final destination! Please, keep in mind that the final code is: <span class="text-cyan-400 font-bold">KVM Forever</span>
        </p>
        
        <div class="bg-slate-700 p-4 rounded-xl w-full mb-6">
          <p class="text-green-300 flex justify-center gap-5">
            <i class="fas fa-star"></i>
